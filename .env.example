# Flask
SECRET_KEY=change-me-to-a-random-string-in-production
FLASK_ENV=development
APP_URL=http://localhost:5700
CONTACT_EMAIL=hello@openjobs.com.au
CONTACT_ADDRESS=Level 1, 1 Market Street, Sydney NSW 2000, Australia
# Optional Google Analytics 4 (loads only after cookie consent)
GA_MEASUREMENT_ID=
# Google OAuth (Sign in with Google on login/register)
GOOGLE_CLIENT_ID=
# Optional error tracking (Sentry)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# Ollama — optional, AI matching fails gracefully if unavailable
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b
JOBSEEK_AI_ENABLED=true

# Email — optional, emails log to console if not configured
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your-sendgrid-api-key
FROM_EMAIL=jobs@openjobs.com

# Stripe — optional, checkout returns 503 demo mode if not set
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# Telegram Bot — optional
TELEGRAM_BOT_TOKEN=

# Data protection — mask emails in admin API responses (default true in production)
ADMIN_MASK_PII=true

# Feature flags (P2) — see notes/ENGINEERING_ROADMAP.md
FEATURE_ADS=true
FEATURE_CHATBOT=true
FEATURE_CHATBOT_AI=false
FEATURE_GUEST_JOB_CACHE=true
FEATURE_OLLAMA_MATCHING=true

# Outbound URL allowlist for scrapers (comma-separated hosts; empty = block private IPs only)
# Comma-separated hosts for scrapers (e.g. education.nsw.gov.au)
ALLOWED_EGRESS_HOSTS=
# Set true to include SEEK in teaching_au scrapes (default: NSW JobFeed only)
SCRAPER_ALLOW_SEEK=false
# All-occupation visa scraper (SEEK + skilled list in data/au_skilled_occupations.json)
SCRAPER_AUTO_START=false
SCRAPER_AUTO_SOURCE=visa_sponsorship_au
SCRAPER_AUTO_INTERVAL_MINUTES=360
SCRAPER_REQUIRE_OCCUPATION_LIST=true
# Optional comma-separated extra SEEK queries for visa_sponsorship_au
# SCRAPER_VISA_EXTRA_QUERIES=devops visa sponsorship,aged care visa sponsorship

# OpenJobs chatbot — privacy / anti-injection
# Public web chat uses rule-based search only unless both are set:
CHATBOT_AI_ENABLED=false
CHATBOT_INTERNAL_SECRET=
# Optional: CHATBOT_MAX_MESSAGE_LEN=500
