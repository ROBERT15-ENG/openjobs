# Flask
SECRET_KEY=change-me-to-a-random-string-in-production
JWT_SECRET=change-me-too   # falls back to SECRET_KEY; required when FLASK_ENV=production
FLASK_ENV=development      # set to "production" to enforce HTTPS redirects and secrets
APP_URL=http://localhost:5700
ALLOWED_ORIGINS=http://localhost:5700

# Database — SQLite file path (tables are created automatically on startup)
DATABASE_URL=jobs.db

# Redis — optional, persists the JWT revocation list and rate limits across restarts/workers
REDIS_URL=

# Ollama — optional, AI matching fails gracefully if unavailable
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b
JOBSEEK_AI_ENABLED=true

# Email — optional. If not configured, new accounts are auto-confirmed and
# confirmation / reset links are printed to the server log instead.
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your-sendgrid-api-key
FROM_EMAIL=jobs@openjobs.com

# Google Sign-In — optional. Required (audience check) when FLASK_ENV=production.
GOOGLE_CLIENT_ID=

# Stripe — optional, checkout returns 503 demo mode if not set
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# Telegram Bot — optional (never commit a real token)
TELEGRAM_BOT_TOKEN=
