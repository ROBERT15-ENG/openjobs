# Flask
SECRET_KEY=change-me-to-a-random-string-in-production
FLASK_ENV=development

# Ollama — optional, AI matching fails gracefully if unavailable
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b
JOBSEEK_AI_ENABLED=true

# Email — optional, emails log to console if not configured
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your-sendgrid-api-key
FROM_EMAIL=jobs@openjobs.com

# Stripe — optional, checkout returns 503 demo mode if not set
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# Telegram Bot — optional
TELEGRAM_BOT_TOKEN=

# Feature flags (P2) — see notes/ENGINEERING_ROADMAP.md
FEATURE_ADS=true
FEATURE_CHATBOT=true
FEATURE_CHATBOT_AI=false
FEATURE_GUEST_JOB_CACHE=true
FEATURE_OLLAMA_MATCHING=true

# Outbound URL allowlist for scrapers (comma-separated hosts; empty = block private IPs only)
ALLOWED_EGRESS_HOSTS=

# OpenJobs chatbot — privacy / anti-injection
# Public web chat uses rule-based search only unless both are set:
CHATBOT_AI_ENABLED=false
CHATBOT_INTERNAL_SECRET=
# Optional: CHATBOT_MAX_MESSAGE_LEN=500
