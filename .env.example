# Flask
SECRET_KEY=change-me-to-a-random-string-in-production
FLASK_ENV=development
BASE_URL=http://localhost:5700
CORS_ORIGINS=http://localhost:5700
DATABASE_PATH=
UPLOAD_DIR=
# Shared rate-limit store for multi-worker deployments (default memory:// is per-process)
RATELIMIT_STORAGE_URI=
LOG_LEVEL=INFO

# Ollama — optional, AI matching fails gracefully if unavailable
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b
JOBSEEK_AI_ENABLED=true

# Email — optional, emails log to console if not configured
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your-sendgrid-api-key
FROM_EMAIL=jobs@openjobs.com
# outbox (default: queue + background drain + scripts/send_outbox.py) or sync
EMAIL_DELIVERY=outbox

# Stripe — optional, checkout returns 503 demo mode if not set
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Google Sign-In — optional (POST /api/auth/google)
GOOGLE_CLIENT_ID=

# Session cookie — set true behind HTTPS
SESSION_COOKIE_SECURE=

# Telegram Bot — optional
TELEGRAM_BOT_TOKEN=
